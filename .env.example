# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml and by the
# backend when run with `mvn spring-boot:run`. Compose refuses to start if a
# required value is missing.
#
# Generate strong values, e.g.:  openssl rand -base64 32

# --- Required ---
DB_PASSWORD=
DB_ROOT_PASSWORD=
# At least 32 random characters; the backend refuses to start otherwise.
JWT_SECRET=
GRAFANA_ADMIN_PASSWORD=

# --- Optional ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# MAILER_URL=
# Frontend build args (see ktebna/.env.example)
# VITE_API_URL=
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=

# Alert emails from Alertmanager (optional; without them alerts show in the UI only).
# For Gmail, ALERT_SMTP_PASSWORD is an App Password (Google Account > Security >
# 2-Step Verification > App passwords), never your normal password.
# ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=your.address@gmail.com
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_HOST=smtp.gmail.com:587
