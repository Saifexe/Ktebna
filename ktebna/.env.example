# URL of the Spring Boot backend (see /backend).
# Local dev via docker-compose: http://localhost:8080
VITE_API_URL=http://localhost:8080

# Google Maps (pickup-spot picker on /sell and the map on book pages).
# Browser key with "Maps JavaScript API" and "Places API (New)" enabled;
# restrict it by HTTP referrer. Leave empty to hide the maps.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Cloud Console (defaults to Google's DEMO_MAP_ID).
VITE_GOOGLE_MAPS_MAP_ID=
