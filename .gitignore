# ===== Secrets =====
# Any .env file anywhere (.env, .env.local, .env.production, …) except the
# committed templates.
.env
.env.*
*.env.local
!.env.example
!**/.env.example
# Keys, certificates, keystores
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# ===== Node / React frontend =====
node_modules/
ktebna/dist/
ktebna/dist-ssr/
ktebna/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Java / Spring Boot backend =====
backend/target/
# User uploads (personal photos) and runtime data, wherever they end up
uploads/
# Local cover images used to fill in listings through the app (not source code)
ktebna/src/books/*.jpg
ktebna/src/books/*.jpeg
ktebna/src/books/*.png
ktebna/src/books/*.webp
*.class
*.jar
!backend/.mvn/wrapper/maven-wrapper.jar
*.log
HELP.md

# ===== Docker =====
# (Dockerfile and docker-compose.yml are meant to be committed —
# nothing Docker-specific needs ignoring unless you add local override files)
docker-compose.override.yml

# ===== IDEs =====
.idea/
*.iml
*.iws
.vscode/
*.swp
*.swo

# ===== OS junk =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Misc =====
*.tmp
*.bak

# ===== Generated analysis =====
graphify-out/

# ===== Database dumps (contain user emails + password hashes) =====
backups/
*.sql
# ...except Flyway migrations: schema only, no data, and the app needs them.
!backend/src/main/resources/db/migration/*.sql
*.sql.gz
*.dump

# ===== Local tooling =====
.vercel/
.claude/

